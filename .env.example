# Copie para .env e preencha localmente. NUNCA faça commit do .env.
# Chave da Opper (começa com "op-"). Obtenha em https://opper.ai
OPPER_API_KEY=
# Endpoint compatível com OpenAI (Chat Completions). Padrão confirmado na doc da Opper:
OPPER_BASE_URL=https://api.opper.ai/v3/compat
# ID do modelo no catálogo da Opper (Qwen3.8-27B OBLITERATED, card HF OBLITERATUS/Qwen3.8-27B-OBLITERATED):
OPPER_MODEL=heabsy/qwen38-obl

# --- Opcionais (valores padrão entre parênteses) ---
# OPPER_TEMPERATURE=0.2          # (0.2) card do modelo recomenda 0.1–0.3 para uso agêntico
# OPPER_MAX_TOKENS=2048          # (2048)
# OPPER_EXTRA_PARAMS={"repetition_penalty":1.15}   # JSON mesclado no corpo da requisição
# OPPER_PRICE_INPUT_PER_MTOK=0.17   # se vazio, o bridge consulta o catálogo público da Opper
# OPPER_PRICE_OUTPUT_PER_MTOK=1.19
# BRIDGE_PORT=8787
# BRIDGE_MAX_STEPS=40            # máximo de chamadas de ferramenta por turno do usuário
# BRIDGE_MAX_REPAIRS=3           # tentativas de correção de formato/validação por resposta
# BRIDGE_LOG_PROMPTS=full        # full | none
# BRIDGE_ENABLE_BROWSER=0        # 1 = registra o servidor MCP do Playwright no Codex
